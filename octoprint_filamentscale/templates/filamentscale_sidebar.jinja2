<div data-bind="visible: !online()">
    <small class="text-error" data-bind="attr: {title: error}">{{ _('Scale offline') }}</small>
</div>
<div data-bind="visible: online() && sensors().length === 0">
    <small class="muted">{{ _('No calibrated sensors') }}</small>
</div>
<table class="table table-condensed filamentscale-table" data-bind="visible: online() && sensors().length > 0">
    <tbody data-bind="foreach: sensors">
        <tr>
            <td data-bind="text: label, attr: {title: label}"></td>
            <td class="filamentscale-grams" data-bind="text: $parent.formatGrams(grams)"></td>
        </tr>
    </tbody>
</table>
