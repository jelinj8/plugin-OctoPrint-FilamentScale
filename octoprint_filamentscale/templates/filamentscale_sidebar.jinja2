<div data-bind="visible: !online()">
    <small class="text-error" data-bind="attr: {title: error}">{{ _('Scale offline') }}</small>
</div>
<div data-bind="visible: online() && sensors().length === 0">
    <small class="muted">{{ _('No calibrated sensors') }}</small>
</div>
<div data-bind="visible: online(), foreach: sensors">
    <div class="filamentscale-row">
        <span class="filamentscale-label" data-bind="text: label, attr: {title: label}"></span>
        <span class="filamentscale-grams" data-bind="text: $parent.formatGrams(grams)"></span>
    </div>
</div>
